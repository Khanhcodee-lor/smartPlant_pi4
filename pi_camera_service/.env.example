FIREBASE_CREDENTIALS_PATH=/etc/smart-plant/firebase-service-account.json
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
PLANT_ID=tomato_001
CAPTURE_DIR=/var/lib/smart-plant/captures
LOG_DIR=/var/log/smart-plant
POLL_INTERVAL_SECONDS=5
MAX_RETRIES=3
RETRY_BASE_SECONDS=1
MAX_IMAGE_BYTES=10485760
DRY_RUN=false
